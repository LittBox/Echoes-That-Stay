
---
import type { CollectionEntry } from 'astro:content';

interface Props {
  echo: CollectionEntry<'echoes'>;
}

const { echo } = Astro.props;


const {
  editorialTitle,
  quote,
  editorialSummary,
  speaker,
  speakerCandidate,
  topics,
} = echo.data;

const displaySpeaker =
  speaker ?? speakerCandidate ?? '说话者待核实';
---

<article class="echo-row">
  <div class="echo-row__meta">
    <span>回声摘录</span>
    {topics.length > 0 && (
      <span>{topics.join(' · ')}</span>
    )}
  </div>

  <h2 class="echo-row__title">
    <a href={`/echoes/${echo.id}/`}>
      {editorialTitle}
      <span aria-hidden="true">↗</span>
    </a>
  </h2>

  <blockquote class="echo-row__quote">
    {quote}
  </blockquote>

  <p class="echo-row__summary">
    {editorialSummary}
  </p>

  <div class="echo-row__footer">
    <span>{displaySpeaker}</span>
  </div>
</article>

<style>
  .echo-row {
    padding: 28px 0;
    border-bottom: 1px solid var(--border, #e5e5e5);
  }

  .echo-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: #777;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .echo-row__title {
    margin: 14px 0 12px;
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.4;
    font-weight: 600;
  }

  .echo-row__title a {
    color: inherit;
    text-decoration: none;
  }

  .echo-row__title a:hover {
    opacity: 0.65;
  }

  .echo-row__quote {
    margin: 0 0 12px;
    padding: 0;
    border: none;
    font-size: 17px;
    line-height: 1.9;
    color: #333;
  }

  .echo-row__summary {
    margin: 0;
    font-size: 14px;
    line-height: 1.8;
    color: #777;
  }

  .echo-row__footer {
    margin-top: 16px;
    font-size: 12px;
    color: #888;
  }
</style>
